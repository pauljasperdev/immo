{
  "name": "immo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/functions/*"
  ],
  "scripts": {
    "check": "biome check --write .",
    "dev": "sst dev",
    "check-types": "bun --recursive check-types",
    "env:apiUrl": "sst shell -- bun --cwd packages/scripts env:apiUrl",
    "build:native": "EXPO_PUBLIC_SERVER_URL=$(bun env:apiUrl) bun --cwd apps/native build",
    "db:push": "sst shell -- bun --cwd packages/core db:push",
    "db:studio": "sst shell -- bun --cwd packages/core db:studio",
    "db:generate": "sst shell -- bun --cwd packages/core db:generate",
    "db:migrate": "sst shell -- bun --cwd packages/core db:migrate"
  },
  "dependencies": {
    "sst": "^3.17.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "ultracite": "5.1.1"
  },
  "packageManager": "bun@1.2.2"
}
