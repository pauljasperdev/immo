{
  "name": "core",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "db:push": "sst shell drizzle-kit push",
    "db:studio": "sst shell drizzle-kit studio",
    "db:generate": "sst shell drizzle-kit generate",
    "db:migrate": "sst shell drizzle-kit migrate"
  },
  "exports": {
    "./*": [
      "./src/*/index.ts",
      "./src/*.ts"
    ]
  },
  "dependencies": {
    "zod": "^4.0.2",
    "drizzle-orm": "^0.44.2",
    "@neondatabase/serverless": "^1.0.1",
    "ws": "^8.18.3",
    "better-auth": "^1.3.4",
    "@better-auth/expo": "^1.3.4",
    "sst": "*"
  },
  "devDependencies": {
    "tsdown": "^0.12.9",
    "typescript": "^5.8.2",
    "tsx": "^4.19.2",
    "@types/node": "^22.13.11",
    "drizzle-kit": "^0.31.2",
    "@types/ws": "^8.18.1"
  }
}
