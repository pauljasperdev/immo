{
  "name": "@immo/core",
  "type": "module",
  "scripts": {
    "build": "bun run tsdown",
    "check-types": "bun run tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "db:push": "sst shell bun run drizzle-kit push",
    "db:studio": "sst shell bun run drizzle-kit studio",
    "db:generate": "sst shell bun run drizzle-kit generate",
    "db:migrate": "sst shell bun run drizzle-kit migrate"
  },
  "exports": {
    "./*": [
      "./src/*/index.ts",
      "./src/*.ts"
    ]
  },
  "dependencies": {
    "@better-auth/expo": "^1.3.4",
    "@neondatabase/serverless": "^1.0.1",
    "better-auth": "^1.3.4",
    "drizzle-orm": "^0.44.2",
    "expo-dev-client": "~5.2.4",
    "sst": "*",
    "ws": "^8.18.3",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.11",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.2",
    "tsdown": "^0.12.9",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  }
}
